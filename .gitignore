
# Spell-Challenge - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Django
*.log
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
local_settings.py

# VS Code and IDEs
.vscode/
.idea/
*.iml

# Testing and coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Build files
build/
dist/
*.egg-info/
.eggs/

# SQLite databases
*.sqlite
*.sqlite3

# Database backups and exports
backups/
database_backups/
sql_backups/
*.sql.gz
*.dump
*.bak
*.backup
*_backup.sql
*-backup.sql
backup_*.sql
*_dump.sql
dump_*.sql

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Credentials
credentials*.json
service-account*.json

# Operating system files
.DS_Store
Thumbs.db
